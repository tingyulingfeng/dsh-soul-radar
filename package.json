{
  "name": "dsh-soul-radar",
  "version": "0.5.7",
  "private": false,
  "description": "A reader-response analyzer for DSH: simulates a real reader's emotional reaction to a piece, parses it into countable data with evidence, and leaves the verdict and advice to DSH. 文章情绪解析与输出辅助插件。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingyulingfeng/dsh-soul-radar.git"
  },
  "homepage": "https://github.com/tingyulingfeng/dsh-soul-radar#readme",
  "bugs": {
    "url": "https://github.com/tingyulingfeng/dsh-soul-radar/issues"
  },
  "author": "听雨聆风 (tingyulingfeng) <1261750529@qq.com>",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness",
    "文章解析",
    "情绪分析",
    "写作辅助",
    "上下文联系",
    "模拟读者",
    "article-analysis",
    "emotion-analysis",
    "reader-response",
    "writing-assistant",
    "context-linking",
    "prose",
    "review"
  ]
}
