{
  "name": "dsh-soul-radar",
  "version": "0.4.3",
  "private": false,
  "description": "A simulated reader that turns reading responses into countable data for DSH.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness",
    "writing",
    "review",
    "chinese"
  ]
}
